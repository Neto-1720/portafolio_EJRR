# Supabase. La anon key es pública: solo permite lo que definan las políticas RLS.
# Nunca pongas SUPABASE_SERVICE_ROLE_KEY en una variable VITE_.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=portfolio

# Origen público del sitio, sin barra final.
# Activa canonical, og:url, og:image absoluta y el sitemap del build.
VITE_SITE_URL=https://portafolio-ejrr.vercel.app

# Opcionales. Si quedan vacíos, GitHub y el CV usan valores por defecto del perfil.
VITE_GITHUB_URL=https://github.com/Neto-1720
VITE_LINKEDIN_URL=
VITE_EMAIL=
VITE_CV_URL=/cv.pdf

# Formulario público de contacto. Apagado salvo que valga "true".
# El POST va a Web3Forms (https://api.web3forms.com/submit).
VITE_CONTACT_FORM_ENABLED=
VITE_WEB3FORMS_ACCESS_KEY=

# Solo para Playwright. No entran al build. Definirlas en el entorno, nunca en Git.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
