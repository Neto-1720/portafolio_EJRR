# URL de la API Laravel, sin barra final.
# En `npm run dev` el navegador usa el proxy de Vite (/api y /sanctum) y esta variable no se usa.
# El build de producción sí la necesita, con cookies de Sanctum y CORS con credenciales.
VITE_API_URL=http://127.0.0.1:8000

# Opcionales. Si quedan vacíos, el enlace no se muestra.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_EMAIL=
VITE_CV_URL=
