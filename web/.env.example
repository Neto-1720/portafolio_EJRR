# URL de la API Laravel, sin barra final.
# En `npm run dev` el navegador usa el proxy de Vite (/api y /sanctum) y esta variable no se usa.
# El build de producción sí la necesita, con cookies de Sanctum y CORS con credenciales.
VITE_API_URL=http://127.0.0.1:8000

# Origen público del sitio, sin barra final. Vacío hasta tener dominio.
# Activa canonical, og:url y el sitemap del build. No inventar un dominio.
VITE_SITE_URL=

# Opcionales. Si quedan vacíos, el enlace no se muestra.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_EMAIL=
VITE_CV_URL=

# Formulario público de contacto. Apagado salvo que valga "true"; mientras tanto
# /contact muestra un aviso con el enlace de LinkedIn y no hace POST a /api/contact.
VITE_CONTACT_FORM_ENABLED=

# Solo para Playwright. No entran al build. Definirlas en el entorno, nunca en Git.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
